<Window x:Class="GlbExport.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLB Export" Width="760" Height="700" MinWidth="640" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F5F5F4" TextElement.Foreground="#333333"
        FontFamily="Lato, Helvetica Neue, Calibri Light, sans-serif" FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#B26E63"/>
        <SolidColorBrush x:Key="AccentHover" Color="#9A5E54"/>
        <SolidColorBrush x:Key="Outline" Color="#C7C5CD"/>
        <SolidColorBrush x:Key="Muted" Color="#A1A1A0"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFF9"/>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#333333"/></Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFFFF9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Destino -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ARCHIVO DE SALIDA" Style="{StaticResource Label}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="out_txt" Grid.Column="0" Height="30"/>
                <Button x:Name="browse_btn" Grid.Column="1" Content="Examinar..." Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <TextBlock x:Name="view_txt" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Perfil -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="PERFIL DE OPTIMIZACION" Style="{StaticResource Label}"/>
                <ComboBox x:Name="preset_cb" Height="30" SelectionChanged="Preset_Changed"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="14,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       Text="Elige un perfil y ajusta cada categoria abajo. 100 % = sin simplificar. Las piezas chicas nunca se simplifican."/>
        </Grid>

        <!-- Categorias -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="CATEGORIAS DE LA VISTA" Style="{StaticResource Label}"/>
            <DataGrid x:Name="cat_grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E3E8"
                      Background="{StaticResource Card}" BorderBrush="{StaticResource Outline}" RowBackground="{StaticResource Card}"
                      AlternatingRowBackground="#FAFAF6" SelectionMode="Single" SelectionUnit="Cell">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Include, Mode=TwoWay}" Width="60"/>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Elementos" Binding="{Binding Count}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Se conserva (%)" Binding="{Binding Ratio, Mode=TwoWay}" Width="110"/>
                    <DataGridTextColumn Header="Error max (cm)" Binding="{Binding ErrorCm, Mode=TwoWay}" Width="105"/>
                    <DataGridCheckBoxColumn Header="Bloquear bordes" Binding="{Binding Lock, Mode=TwoWay}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- General -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <CheckBox x:Name="inst_chk" Content="Usar instancias para elementos repetidos (recomendado)" IsChecked="True"/>
                <CheckBox x:Name="center_chk" Content="Recentrar el modelo en el origen" IsChecked="True"/>
                <CheckBox x:Name="links_chk" Content="Incluir vinculos de Revit visibles" IsChecked="True"/>
                <CheckBox x:Name="onesided_chk" Content="Una sola cara: descarta la trasera (mas liviano)" IsChecked="True"
                          ToolTip="Las categorias abiertas o con datos inconsistentes de Revit siguen a doble cara. Desmarcalo si ves huecos en el visor."/>
                <CheckBox x:Name="vcolor_chk" Content="Color en los vertices (menos draw calls)" IsChecked="True"
                          ToolTip="Un solo material opaco para todo; el color va en los vertices. Lo transparente conserva su material."/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="No simplificar piezas con menos de" VerticalAlignment="Center"/>
                    <TextBox x:Name="mintris_txt" Width="56" Margin="8,0,8,0" Text="300" HorizontalContentAlignment="Right"/>
                    <TextBlock Text="triangulos" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            ToolTip="Parte la geometria fija en celdas para que el visor descarte las que quedan fuera de la camara. Suma draw calls: en las pruebas no mejoro; 0 = no partir.">
                    <TextBlock Text="Partir en celdas de" VerticalAlignment="Center"/>
                    <TextBox x:Name="cell_txt" Width="56" Margin="8,0,8,0" Text="0" HorizontalContentAlignment="Right"/>
                    <TextBlock Text="m (0 = no)" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Acciones -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="hint_txt" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="La exportacion toma unos minutos y Revit queda ocupado."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="export_btn" Content="Exportar" Style="{StaticResource Primary}" Click="Export_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
